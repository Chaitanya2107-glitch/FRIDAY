{"nodes": [{"id": "island_readme_friday_island_setup_and_runtime_guide", "label": "FRIDAY Island setup and runtime guide", "file_type": "document", "source_file": "island/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "island_readme_integrated_lifecycle_and_offline_desktop_surfaces", "label": "Integrated lifecycle and offline desktop surfaces", "file_type": "concept", "source_file": "island/README.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current guide makes Island the primary desktop surface under the existing desktop lifecycle; standalone launches reuse it. Native apps/projects/settings remain available offline, and manually started backends retain independent ownership."}, {"id": "island_readme_trusted_shared_tracker_plugin_contract", "label": "Trusted shared tracker plugin contract", "file_type": "concept", "source_file": "island/README.md", "source_location": "L390", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trusted Python plugins expose bounded literal-text widgets and validate mutations/revisions. Shipped habits, todo and college adapters reuse real FRIDAY data rather than app-config copies or injected frontend code."}, {"id": "island_readme_native_launch_ids_and_shared_config_integrity", "label": "Native launch IDs and shared config integrity", "file_type": "rationale", "source_file": "island/README.md", "source_location": "L223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only current catalog IDs or saved manual pin/project IDs launch; free text cannot supply an executable or arguments. Shared Python/Rust config uses validation, locking, atomic replacement, revision checks and a content stamp."}], "edges": [{"source": "island_readme_friday_island_setup_and_runtime_guide", "target": "island_readme_integrate