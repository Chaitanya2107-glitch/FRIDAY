# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── ACTIVE PROVIDER ───────────────────────────────────────────────────────────
# Local execution; AI understands natural commands and handles conversation.
AI_ASSIST_ONLY=true
AI_LANGUAGE_ENABLED=true
# Explicit supervised browser/Windows tasks and bounded research; browsers visible by default.
BROWSER_AUTOMATION_ENABLED=true
AI_WORDING_ENABLED=true
AI_KNOWLEDGE_ENABLED=true
AI_WORDING_TIMEOUT_SECONDS=8
# Brain reviews use local Ollama only, with no cloud fallback.
# Turning review off holds reminders for retry and silences proactive candidates.
NOTIFICATION_REVIEW_ENABLED=true
NOTIFICATION_REVIEW_TIMEOUT_SECONDS=20
NOTIFICATION_REVIEW_RETRY_SECONDS=60
# Bounded, proposal-only review of changed evidence, including assist-only mode.
# Also respects REASONING_ENABLED and the local 'executive review off' control.
COGNITIVE_REVIEW_ENABLED=true
# Starts an installed Ollama server silently when needed; never downloads models.
OLLAMA_AUTO_START=true
OLLAMA_START_TIMEOUT_SECONDS=10
# Stop FRIDAY's own server after five idle minutes; externally started servers stay running.
OLLAMA_IDLE_SECONDS=300
# Legacy manual training-catalogue bounds; live inquiry has no evening queue or fixed question count.
EVENING_QUESTION_LIMIT=8
LEARNING_SESSION_QUESTIONS=20
QUESTION_RETRY_HOURS=24

# Which AI backend to use.
# RECOMMENDED: openrouter (one key, access to 200+ models)
# Options: openrouter | anthropic | openai | ollama
ACTIVE_PROVIDER=openrouter


# ── OPENROUTER (RECOMMENDED) ──────────────────────────────────────────────────
# One API key gives you access to Claude, GPT, Llama, Gemini, Mistral and more.
# Get your free key at: https://openrouter.ai
# Browse all models at: https://openrouter.ai/models
OPENROUTER_API_KEY=your_openrouter_key_here

# Which model to use — change anytime, no code changes needed.
# Cheap + fast options (good for testing):
#   meta-llama/llama-3.1-8b-instruct    ← FREE on OpenRouter
#   google/gemini-flash-1.5             ← very cheap
#   anthropic/claude-haiku-4-5          ← cheap Claude
# Smart options (for production use):
#   anthropic/claude-sonnet-4-5         ← best Claude balance
#   openai/gpt-4o                       ← GPT-4o
#   openai/gpt-4o-mini                  ← cheaper GPT-4
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# Backup models, tried in order when one is busy (comma-separated). Mix companies.
OPENROUTER_BACKUP_MODELS=


# ── DIRECT PROVIDERS (optional — only if NOT using OpenRouter) ────────────────
# Leave these blank if you're using OpenRouter above.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
# Point at any OpenAI-compatible gateway, e.g. OmniRoute: http://localhost:20128/v1
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q5_K_M


# ── LIGHT MODEL (optional) ────────────────────────────────────────────────────
# Short, simple messages try the local Ollama model first (~0.5 s instead of
# seconds on a cloud model); code, explanations and answers from files/web
# keep the main model. false = always the main model.
QUICK_CHAT_LOCAL=true
# Bounded evidence/consequence pass before ordinary replies; uses the configured provider.
# false disables new passes; existing approved dated changes stay until expiry/correction/forgetting.
REASONING_ENABLED=true


# ── COMMAND DETECTION (optional) ──────────────────────────────────────────────
# When a message looks like a command but no local rule matches, FRIDAY lets an
# AI pick which system tools to call (native tool calling). That's a small task,
# so by default it uses a cheap model on your chat provider (GPT-4o-mini on
# OpenRouter and OpenAI, Claude Haiku on Anthropic) and falls back to your chat
# model if that fails. The model must support tool calling — on Ollama, use one
# that does (e.g. qwen3, llama3.1).
# To pick one yourself, set BOTH — e.g. INTENT_PROVIDER=ollama, INTENT_MODEL=gemma3:4b
INTENT_PROVIDER=
INTENT_MODEL=


# ── SCREEN QUESTIONS (optional) ───────────────────────────────────────────────
# "What's on my screen?" sends a screenshot of the monitor your mouse is on to a
# model that can read images. By default that's a cheap vision model on your chat
# provider (GPT-4o-mini on OpenRouter/OpenAI, Claude Haiku on Anthropic); Ollama
# uses OLLAMA_MODEL, which must then be a vision model (e.g. gemma3:4b).
# To pick one yourself, set BOTH — e.g. VISION_PROVIDER=ollama, VISION_MODEL=gemma3:4b
VISION_PROVIDER=
VISION_MODEL=
# Comma-separated OpenRouter models that support image understanding. These are
# tried after its vision model fails, instead of OPENROUTER_BACKUP_MODELS.
# Blank = no extra models on OpenRouter. Provider failover still follows
# FALLBACK_PROVIDERS. Choose general vision models, not moderation models.
OPENROUTER_VISION_BACKUP_MODELS=


# ── PROVIDER FAILOVER (optional) ──────────────────────────────────────────────
# If your AI provider fails (outage, rate limit, bad key, Ollama not running),
# FRIDAY retries on fallback providers. Blank = every other provider that has an
# API key, then Ollama. Or set an order (e.g. anthropic, ollama), or "none" to
# never fall back — useful if you don't want a paid provider used without noticing.
FALLBACK_PROVIDERS=


# ── SPOTIFY (optional, needs Spotify Premium) ─────────────────────────────────
# Lets FRIDAY really play songs, playlists and liked songs, shuffle, repeat,
# queue and like songs. Without it, music commands still control the open player.
# One-time setup:
#   1. developer.spotify.com/dashboard → Create app (tick "Web API")
#   2. Redirect URI: http://127.0.0.1:8000/api/v1/spotify/callback
#      (use your API_PORT if you changed it; Spotify rejects "localhost")
#   3. Paste the app's Client ID below (no client secret needed) and restart FRIDAY
#   4. Say or type "connect Spotify" and log in once in the browser
SPOTIFY_CLIENT_ID=


# ── FILE SEARCH (optional) ────────────────────────────────────────────────────
# FRIDAY indexes these folders in the background: every file by name, plus the
# text inside documents, PDFs, Word/PowerPoint/Excel files and code. Then
# "find my resume" lists matching files ("open 1" opens one), and "what does my
# lease say about pets?" / "according to my notes, …" / "\d <question>" answers
# from them. Answers send the matching excerpts to your AI provider; indexing
# itself is fully local (a small embedding model, on the GPU if there is one).
# Folders are separated by semicolons. Blank = Documents, Desktop and Downloads.
FILE_SEARCH_FOLDERS=
FILE_SEARCH_ENABLED=true
FILE_SEARCH_RESCAN_MINUTES=30
# FILE_SEARCH_EMBED_MODEL=BAAI/bge-small-en-v1.5


# ── VOICE (optional) ──────────────────────────────────────────────────────────
# Speech-to-text model size: tiny | base | small | medium (bigger = more accurate, slower)
WHISPER_MODEL=small
# Microsoft neural voices (browse with: edge-tts --list-voices)
EDGE_TTS_VOICE=en-US-AriaNeural
# Used for replies written in Hindi
EDGE_TTS_HINDI_VOICE=hi-IN-SwaraNeural


# ── MEMORY ────────────────────────────────────────────────────────────────────
MEMORY_DB_PATH=memory/friday.db
COGNITION_ENABLED=true
# Shared local event memory: retain at most this many events and characters per event.
COGNITION_MAX_EVENTS=500
COGNITION_EVENT_CHARS=16000
# Maximum shared workspace characters added to AI prompts (local-only contents omitted).
COGNITION_PROMPT_CHARS=3200

# Local data-quality catalog, filtered next-app training, and weekly Telegram audit.
LEARNING_DATA_ENABLED=true
LEARNING_MIN_SESSION_SECONDS=5
LEARNING_MAX_GAP_SECONDS=60
LEARNING_AUTOMATION_WINDOW_SECONDS=60
MAX_HISTORY_MESSAGES=10
# Long-term memory: FRIDAY learns facts about you from chat ("I'm vegetarian")
# using a cheap AI call in the background. "remember that …" works either way;
# "what do you remember about me" / "forget that …" to review and delete.
SEMANTIC_MEMORY_LEARN=true
# Activity log: which app you use when, and every command FRIDAY runs — kept on
# this PC as data for learning your habits. App names only, never window titles
# or typed text. "what have I been doing today" / "clear my activity log".
ACTIVITY_LOG_ENABLED=true
# "Hey Friday": only listened for while switched on (tray or Ctrl+Alt+H). A phrase
# has to start what you say; whatever follows is the command. Auto-off after this long.
WAKE_PHRASES=hey friday,hi friday,ok friday,okay friday,hello friday,k friday,hay friday
WAKE_AUTO_OFF_MINUTES=30
# Morning briefing: the first time you're at the laptop each day after this hour,
# a notification with the weather, today's reminders, battery and yesterday's activity.
# "brief me" gives it any time. WEATHER_CITY blank = no weather (Open-Meteo, free).
BRIEFING_ENABLED=true
BRIEFING_AFTER_HOUR=6
WEATHER_CITY=
# Daily morning briefing on Telegram, every day (laptop local time; blank = off)
TELEGRAM_BRIEFING_HOUR=7
TELEGRAM_NIGHTLY_HOUR=21
TELEGRAM_WEEKLY_HOUR=21
# Monday=0 ... Sunday=6
TELEGRAM_WEEKLY_DAY=6
# Campus Wi-Fi login page: opened (and signed into with "save my wifi login") when Wi-Fi has no internet.
# Other networks' login pages only get a notification. Blank = never sign in automatically.
CAMPUS_WIFI_PORTAL=captiveportal.reva.edu.in
# Nudges: notifications for low battery, a hot GPU / full memory, hours in one app,
# low disk. Never spoken.
# "pause nudges for an hour", "turn off nudges", "turn on nudges".
NUDGES_ENABLED=true
LONG_APP_HOURS=3
# Telegram bot: control FRIDAY from your phone, and get notifications there when
# you've been away TELEGRAM_AWAY_MINUTES. Make a bot with @BotFather, paste its token,
# restart, message the bot: it replies with your user ID to put below. Keep the token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_AWAY_MINUTES=10
# "It's done" alerts: Claude Code replies / terminal commands that took this long,
# heavy CPU/GPU work that ran this long, and how often watched webpages are checked
DONE_MIN_MINUTES=2
HEAVY_WORK_MINUTES=10
WEB_WATCH_MINUTES=10


# ── API SERVER ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true
# Auto-restart the server when code changes (defaults to DEBUG).
# launch_friday.vbs always turns this off.
# API_RELOAD=true

# First day of this semester (YYYY-MM-DD) for "semester wrap-up". Blank = since FRIDAY started logging.
SEMESTER_START=
