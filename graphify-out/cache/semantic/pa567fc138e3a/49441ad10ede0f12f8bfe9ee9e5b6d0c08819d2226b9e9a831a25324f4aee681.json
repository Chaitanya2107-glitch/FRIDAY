{"nodes": [{"id": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_implemented_learning_data_quality_design", "label": "Implemented learning data quality design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Document status explicitly records implementation and activation on 2026-10-12 with 1740 tests passed."}, {"id": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_boundary_preserving_next_app_eligibility", "label": "Boundary preserving next app eligibility", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design marked implemented and activated requires actual adjacent observed outcomes with stable IDs, separate feature/label times and source continuity. Rejected sessions, restarts and autonomous or unknown origins cannot fabricate natural-user labels."}, {"id": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_frozen_aggregate_learning_audit", "label": "Frozen aggregate learning audit", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented design uses scheduled half-open cutoffs and immutable retry snapshots with honest coverage, screening, fitting/evaluation and promotion counts. Aggregate Telegram reports omit private raw content and reuse configured delivery policy."}, {"id": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_stable_source_identity_accounting", "label": "Stable source identity accounting", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source records and derived transition examples use distinct accounting units. A metadata-only catalog preserves source authority, revisions and revocation; reprocessing or weighting cannot inflate collected or training counts."}], "edges": [{"source": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_implemented_learning_data_quality_design", "target": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_boundary_preserving_next_app_eligibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L102", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_implemented_learning_data_quality_design", "target": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_frozen_aggregate_learning_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L158", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_implemented_learning_data_quality_design", "target": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_stable_source_identity_accounting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-12-learning-data-quality-design.md", "source_location": "L36", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_12_learning_data_quality_design_implemented_learning_data_quality_design", "target": "services_activity_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-12-learning