{"nodes": [{"id": "docs_plugins_friday_plugins_api_version_1", "label": "FRIDAY plugins API version 1", "file_type": "document", "source_file": "docs/PLUGINS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen implementation guide describes trusted Python plugins, managed lifecycle, bundled hello/todo/system_events and authenticated HTTP/SSE integration; initial activation requires loading the host in the backend."}, {"id": "docs_plugins_trusted_python_plugin_host", "label": "Trusted Python plugin host", "file_type": "concept", "source_file": "docs/PLUGINS.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plugins execute in-process without a sandbox. Manifest permissions declare intended access rather than enforcing Python/OS restrictions; discovery validates manifests and installed dependency names but never invokes pip or installs dependencies automatically."}, {"id": "docs_plugins_cooperative_reload_fencing_and_failure_isolation", "label": "Cooperative reload fencing and failure isolation", "file_type": "rationale", "source_file": "docs/PLUGINS.md", "source_location": "L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managed jobs must cooperate with stop_event. Unload fences the old API, removes registrations and imports fresh entry/helper generations; raw OS APIs remain outside those guards. Five uncaught failures within 60 seconds persist auto-disable until explicitly enabled. Discovery polls every two seconds after the initial backend host load."}, {"id": "docs_plugins_protected_plugin_http_and_sse_bridge", "label": "Protected plugin HTTP and SSE bridge", "file_type": "concept", "source_file": "docs/PLUGINS.md", "source_location": "L251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The existing loopback API hosts plugin routes/actions and event streaming beside the WebSocket. X-Friday-Token plus Host, Origin and loopback checks protect endpoints; Island uses header-based fetch streaming, access logs strip queries and token rotation closes old SSE/WebSocket sessions."}, {"id": "docs_plugins_independent_json_todo_plugin_persistence", "label": "Independent JSON todo plugin persistence", "file_type": "concept", "source_file": "docs/PLUGINS.md", "source_location": "L288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundled todo stores todos.json under the plugin user-data directory and exposes its own service/route. Built-in command precedence makes todo list collide, so plugin todos/todos/todo show list plugin items. Island combines plugin items with existing workspace rows without migrating or deleting task data; atomic writes preserve data across disable/reload."}], "edges": [{"source": "docs_plugins_friday_plugins_api_version_1", "target": "docs_plugins_trusted_python_plugin_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLUGINS.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_plugins_friday_plugins_api_version_1", "target": "docs_plugins_cooperative_reload_fencing_and_failure_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLUGINS.md", "source_location": "L194", "weight": 1.0}, {"source": "docs_plugins_friday_plugins_api_version_1", "target": "docs_plugins_protected_plugin_http_and_sse_bridge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLUGINS.md", "source_location": "L251", "weight": 1.0}, {"source": "docs_plugins_friday_plugins_api_version_1", "target": "docs_plugins_independent_json_todo_plugin_persistence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLUGINS.md", "source_location": "L