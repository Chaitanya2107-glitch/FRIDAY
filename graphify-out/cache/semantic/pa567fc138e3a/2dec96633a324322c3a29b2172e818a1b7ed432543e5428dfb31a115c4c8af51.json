{"nodes": [{"id": "island_docs_protocol_friday_island_protocol_v1", "label": "FRIDAY Island protocol v1", "file_type": "document", "source_file": "island/docs/PROTOCOL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "island_docs_protocol_authenticated_bounded_local_websocket_protocol", "label": "Authenticated bounded local WebSocket protocol", "file_type": "concept", "source_file": "island/docs/PROTOCOL.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protocol binds IPv4 loopback on default port 17321 with exact allowed origins, five-second token handshake, constant-time comparison, frame/rate limits and token rotation. This is a same-user boundary, not protection from config-reading malware."}, {"id": "island_docs_protocol_connection_bound_commands_and_typing_tokens", "label": "Connection bound commands and typing tokens", "file_type": "rationale", "source_file": "island/docs/PROTOCOL.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrated commands return one-use keyboard tokens rather than raw steps. Original foreground identity is checked; disconnect does not imply rollback and commands are never automatically retried, preventing duplicate actions."}, {"id": "island_docs_protocol_revision_checked_tracker_widget_actions", "label": "Revision checked tracker widget actions", "file_type": "concept", "source_file": "island/docs/PROTOCOL.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic literal-text widgets submit deliberate authenticated plugin_action requests; each registered adapter validates action, record, date and revision. Shared Tracker/workspace plan-completion rules remain authoritative."}], "edges": [{"source": "island_docs_protocol_friday_island_protocol_v1", "t