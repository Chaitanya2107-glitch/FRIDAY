{"nodes": [{"id": "docs_superpowers_specs_2026_09_29_auto_sessions_design_auto_sessions_and_summaries_approved_design", "label": "Auto sessions and summaries approved design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-29-auto-sessions-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_29_auto_sessions_design_local_foreground_session_grouping", "label": "Local foreground session grouping", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-29-auto-sessions-design.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approved design derives sessions from activity rows without a new table or AI: default mode categories merge across gaps of at most ten minutes and require ten minutes of group activity; neutral categories neither break nor extend sessions."}, {"id": "docs_superpowers_specs_2026_09_29_auto_sessions_design_confirmed_mode_suggestions_and_local_summaries", "label": "Confirmed mode suggestions and local summaries", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-29-auto-sessions-design.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design offers eligible modes with explicit Yes/No and rate limits, summarizes ended sessions and writes Sunday journal summaries. It never ends a mode autonomously; Telegram uses existing away-only mirroring."}], "edges": [{"source": "docs_superpowers_specs_2026_09_29_auto_sessions_design_auto_sessions_and_summaries_approved_design", "target": "docs_superpowers_specs_2026_09_29_auto_sessions_design_local_foreground_session_grouping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-29-auto-sessions-design.md", "source_location": "L12", "we